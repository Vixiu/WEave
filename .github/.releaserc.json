{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "writerOpts": {
          "mainTemplate": "{{#if noteGroups}}\n{{#each noteGroups}}\n### {{title}}\n\n{{#each notes}}\n* {{text}}\n{{/each}}\n\n{{/each}}\n{{/if}}\n\n{{#if commitGroups}}\n<details><summary>Detailed Changelog</summary>\n\n{{#each commitGroups}}\n### {{title}}\n\n{{#each commits}}\n* {{#if scope}}**{{scope}}:** {{/if}}{{subject}}{{#if href}} ([{{shortHash}}]({{href}})){{/if}}\n{{/each}}\n\n{{/each}}\n</details>\n{{/if}}"
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node .github/scripts/bump.mjs ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "package.json",
          "package-lock.json",
          "src-tauri/Cargo.toml",
          "src-tauri/Cargo.lock",
          "src-tauri/tauri.conf.json",
          "src-tauri/src/core/constants.rs"
        ],
        "message": "chore(release): bump version to ${nextRelease.version} [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "dist_artifacts/*.exe" },
          { "path": "dist_artifacts/*.msi" },
          { "path": "dist_artifacts/*.zip" }
        ]
      }
    ]
  ]
}
